# Public Monitor API base URL (no trailing slash required).
# Production default is baked into the app when unset.
NEXT_PUBLIC_API_BASE_URL=https://api.monitor.dimikog.org

# Optional display metadata (defaults match Besu Edu-Net).
NEXT_PUBLIC_NETWORK_NAME=Besu Edu-Net
NEXT_PUBLIC_CHAIN_ID=424242

# Blockscout base used for Recent Blocks links.
NEXT_PUBLIC_BLOCKSCOUT_BASE_URL=https://blockexplorer.dimikog.org
