[Unit]
Description=Besu Monitor infrastructure collect and publish pipeline
Documentation=file:///home/ubuntu/besu-network-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/besu-network-monitor
ExecStart=/usr/bin/python3 /home/ubuntu/besu-network-monitor/scripts/run_infrastructure_pipeline.py

# Do not restart or linger as a long-running process.
Restart=no
RemainAfterExit=no

# Journal logging for operational diagnosis.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=besu-monitor-infrastructure

# Mild hardening only. Deliberately avoids ProtectHome / ProtectSystem=strict
# so the job can read ~/.ssh/besu_monitor_publisher, write
# output/infrastructure_snapshot.json, query local Prometheus, and SCP/SSH
# to my-backend. Does not require validator collector SSH access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
